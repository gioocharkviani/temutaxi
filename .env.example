# Copy to .env and fill in. On Vercel, add the same names under Settings > Environment Variables.

# Yandex Fleet API
BASE_URL=https://fleet-api.taxi.yandex.net
API_KEY=
CLIENT_ID=
PARK_ID=

# Applied to every new driver. BALANCE_LIMIT: orders are blocked while the balance is below this.
BALANCE_LIMIT=
# One of the park's enabled work rules. Optional only if the park has exactly one enabled rule.
WORK_RULE_ID=

# MySQL database for the rating and the admin panel
DATABASE_URL=mysql://temutaxi:PASSWORD@127.0.0.1:3333/temutaxi

# A long random value. Only needed where no server keeps running (for example Vercel): an outside scheduler calls
# /api/cron/rating-sync every hour with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# E-mail about each new application (nodemailer). Recipients are set in the admin panel, /admin/email.
# Gmail: smtp.gmail.com, port 587, your Gmail address and an App password (not the normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
